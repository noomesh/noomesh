{
  "format": "noo-addon-node-workloads/1",
  "workloads": [
    {
      "name": "worker",
      "image": "addon-worker",
      "uid": 1000,
      "command": [
        "rhaddon-worker"
      ],
      "port": 9003,
      "protocols": [
        "http",
        "ws"
      ],
      "health": {
        "ready": "/health/ready",
        "live": "/health/live",
        "start_secs": 300
      },
      "drain": {
        "path": "/v1/lifecycle/drain",
        "timeout_secs": 420
      },
      "accel": {
        "gpu": 1,
        "realtime": true
      },
      "models": [
        {
          "slot": "main",
          "target": "/models/main",
          "accepts": {
            "kind": "chat",
            "runtime": "rh-s2s"
          }
        },
        {
          "slot": "voices",
          "target": "/models/voices",
          "accepts": {
            "kind": "voice-pack"
          },
          "many": false,
          "optional": true
        }
      ],
      "env": {
        "RHADDON_SLOTS": {
          "min": 1,
          "max": 4
        },
        "RHADDON_QUANT": {
          "one_of": [
            "int8"
          ]
        },
        "RHADDON_LOG_AUDIO": {
          "one_of": [
            "false"
          ]
        }
      },
      "scratch": [
        {
          "target": "/cache",
          "max_mb": 4096
        },
        {
          "target": "/tmp",
          "tmpfs_mb": 256
        }
      ],
      "limits": {
        "ram_mb": 24576,
        "cpus": 4,
        "pids": 512
      }
    }
  ]
}
