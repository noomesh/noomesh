#!/usr/bin/env python3
"""noo-kiosk-cdp — the display's tiny hands: mint, and the browser's one parent.

Stdlib only (a stock Ubuntu has python3, nothing else is promised), so this
file works the first time it runs.

There is NO durable secret to protect here: the display mints by proving its
tailnet identity (publish a nonce on its own tailnet address, let the
controller come and read it), so nothing is stored between mints except the
short-lived token in /var/lib/kiosk/token.json, which `noo-kiosk-serve` uses.
Nothing travels on argv either way.

THE BROWSER HAS NO DEBUGGING PORT (followup 188). It used to listen on a
loopback TCP port, and loopback is not a permission: TCP has no file modes, so
any local user could attach, drive the browser to anything this display's
tailnet identity can reach, and evaluate script in the page. Now Chrome runs
with `--remote-debugging-pipe` as the child of `broker`, which holds the only
end of that pipe and offers two things:

  - $STATE/page.json (0644, nothing secret): the page's heartbeat, build and
    frame measure, rewritten every PUBLISH_EVERY seconds. Anyone may read
    it, so `noo kiosk status` and the seat heartbeat need no privilege.
  - one verb, `reload`, on a unix socket. The caller is checked with
    SO_PEERCRED against root, the display user, and the owner of the
    directory these scripts live in (the seat user on an enrolled seat, who
    can already rewrite this file, so reloading the page grants it
    nothing). There is no raw CDP on the socket: an allowed caller still
    cannot navigate or evaluate.

Subcommands (all exit non-zero on failure):
  mint                  prove tailnet identity, write token.json (0600)
  broker -- BROWSER...  run the browser on the pipe; exits when it does
  reload                ask the broker to reload the page
  heartbeat             window.__nooKioskHeartbeat (ms epoch) or "null"
  frame                 the graph page's {ms, quality} frame measure as JSON, or "null"
  build                 the stack tag this console was built from, or "null"
  probe                 exit 0 iff the broker published within FRESH_FOR seconds
"""
import http.server, json, os, secrets, socket, string, struct, subprocess, sys, threading, time, urllib.request, urllib.error

STATE = os.environ.get("NOO_KIOSK_STATE", "/var/lib/kiosk")
TOKEN_FILE = os.path.join(STATE, "token.json")
PAGE_FILE = os.path.join(STATE, "page.json")
# kiosk.service's RuntimeDirectory, so systemd creates it for the display
# user and removes it with the session: a socket never outlives its broker.
SOCK = "/run/kiosk/cdp.sock"
PUBLISH_EVERY = 10  # seconds
# Older than this, page.json says the browser stopped answering. Several
# publishes wide, so one slow evaluate is not a strike against the display.
FRESH_FOR = 45  # seconds




def die(msg, code=1):
    print(f"noo-kiosk-cdp: {msg}", file=sys.stderr)
    sys.exit(code)


# ── token ──────────────────────────────────────────────────────────────


def tailnet_ip():
    """This display's OWN tailnet address, or None.

    The bind address for the dialback listener is resolved here and
    NOWHERE else. If this returns None the mint REFUSES — see bind_proof.
    """
    for argv in (["tailscale", "ip", "-4"], ["/usr/bin/tailscale", "ip", "-4"]):
        try:
            out = subprocess.run(argv, capture_output=True, text=True, timeout=10)
        except Exception:  # noqa: BLE001
            continue
        if out.returncode == 0:
            for line in out.stdout.split():
                line = line.strip()
                if line.startswith("100."):
                    return line
    # Fall back to the JSON shape, which some builds prefer.
    for argv in (["tailscale", "status", "--json"], ["/usr/bin/tailscale", "status", "--json"]):
        try:
            out = subprocess.run(argv, capture_output=True, text=True, timeout=10)
        except Exception:  # noqa: BLE001
            continue
        if out.returncode != 0:
            continue
        try:
            ips = json.loads(out.stdout).get("Self", {}).get("TailscaleIPs") or []
        except Exception:  # noqa: BLE001
            continue
        for ip in ips:
            if isinstance(ip, str) and ip.startswith("100."):
                return ip
    return None


class _Nonce(http.server.BaseHTTPRequestHandler):
    nonce = ""

    def do_GET(self):  # noqa: N802
        body = self.nonce.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_a):  # silence; the journal has enough
        return


def bind_proof(ip, port, nonce):
    """Serve `nonce` on (ip, port) ONLY.

    The bind address is the resolved tailnet address, never a wildcard.
    A wildcard bind would also answer on the LOCAL NETWORK, where no
    tailnet ACL applies — the tag:controller -> tag:kiosk grant would
    bound nothing and the mint would still succeed, so nothing would ever
    report the difference. That is why there is no fallback here: if the
    address cannot be resolved we refuse to mint at all.
    """
    _Nonce.nonce = nonce
    srv = http.server.HTTPServer((ip, port), _Nonce)
    t = threading.Thread(target=srv.serve_forever, kwargs={"poll_interval": 0.2}, daemon=True)
    t.start()
    return srv


def mint():
    url = os.environ.get("NOO_KIOSK_URL", "").rstrip("/")
    if not url:
        die("NOO_KIOSK_URL must be set (from /etc/default/kiosk)")
    port = int(os.environ.get("NOO_KIOSK_DIALBACK_PORT", "8099"))

    ip = tailnet_ip()
    if not ip:
        die(
            "cannot resolve this display's tailnet address — refusing to mint. "
            "Binding the dialback listener to a wildcard would expose it on the local "
            "network, where the tailnet ACL does not apply. Is tailscaled running and "
            "is this device logged in?",
            6,
        )

    nonce = "".join(secrets.choice(string.ascii_letters + string.digits) for _ in range(32))
    srv = None
    try:
        try:
            srv = bind_proof(ip, port, nonce)
        except OSError as e:
            die(f"cannot bind the dialback listener on {ip}:{port}: {e}", 6)
        req = urllib.request.Request(
            url + "/api/kiosk/token/tailnet",
            data=json.dumps({"tailnet_ip": ip, "proof_nonce": nonce, "proof_port": port}).encode(),
            method="POST",
            headers={"Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                body = json.loads(r.read().decode() or "{}")
        except urllib.error.HTTPError as e:
            detail = ""
            try:
                detail = json.loads(e.read().decode() or "{}").get("error", {}).get("message", "")
            except Exception:  # noqa: BLE001
                pass
            die(f"mint refused: HTTP {e.code} {detail}", 4)
        except Exception as e:  # noqa: BLE001
            die(f"mint failed: {e}", 3)
    finally:
        # EVERY exit path closes the listener, including the failures
        # above — a mint that errors must not leave the port held. `die`
        # raises SystemExit, which this finally still runs for.
        if srv is not None:
            srv.shutdown()
            srv.server_close()

    token = body.get("token")
    ttl = int(body.get("expires_in") or 900)
    if not token:
        die("mint answered without a token")
    now = int(time.time())
    rec = {"token": token, "expires_at": now + ttl, "minted_at": now,
           "consumer": body.get("consumer"), "via": "tailnet"}
    os.makedirs(STATE, exist_ok=True)
    tmp = TOKEN_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(rec, f)
    os.replace(tmp, TOKEN_FILE)
    print(json.dumps({"expires_at": rec["expires_at"], "consumer": rec["consumer"], "via": "tailnet"}))



# ── the pipe: CDP over the browser's fds 3 and 4 ───────────────────────


class Pipe:
    """Chrome reads commands on fd 3 and writes replies on fd 4, each one a
    JSON message ended by a NUL. One reader thread files replies by id, so
    the publisher and the socket can both call without reading each
    other's answers."""

    def __init__(self, wfd, rfd):
        self.w, self.r = wfd, rfd
        self.lock = threading.Lock()
        self.pending = {}
        self.next_id = 0
        self.closed = False
        self.session = None
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        buf = b""
        while True:
            try:
                chunk = os.read(self.r, 65536)
            except OSError:
                chunk = b""
            if not chunk:
                self.closed = True
                with self.lock:
                    for slot in self.pending.values():
                        slot[0].set()
                return
            buf += chunk
            while b"\0" in buf:
                raw, buf = buf.split(b"\0", 1)
                try:
                    m = json.loads(raw)
                except ValueError:
                    continue
                if "id" in m:
                    with self.lock:
                        slot = self.pending.pop(m["id"], None)
                    if slot:
                        slot[1] = m
                        slot[0].set()
                elif m.get("method") == "Target.detachedFromTarget" and m.get("params", {}).get("sessionId") == self.session:
                    self.session = None

    def call(self, method, params=None, session=None, timeout=15):
        if self.closed:
            raise RuntimeError("the browser has gone")
        slot = [threading.Event(), None]
        with self.lock:
            self.next_id += 1
            mid = self.next_id
            self.pending[mid] = slot
            msg = {"id": mid, "method": method, "params": params or {}}
            if session:
                msg["sessionId"] = session
            data = json.dumps(msg).encode() + b"\0"
            while data:
                data = data[os.write(self.w, data):]
        if not slot[0].wait(timeout):
            with self.lock:
                self.pending.pop(mid, None)
            raise RuntimeError(f"{method}: no reply in {timeout}s")
        m = slot[1]
        if m is None:
            raise RuntimeError("the browser has gone")
        if "error" in m:
            raise RuntimeError(f"{method}: {m['error']}")
        return m.get("result", {})

    def page_session(self):
        """A session on the page the display shows, attached on first use.

        Prefers a real http(s) document: Chrome lists internal surfaces as
        page targets too, and "the first target" is not reliably ours."""
        if self.session:
            return self.session
        pages = [t for t in self.call("Target.getTargets").get("targetInfos", []) if t.get("type") == "page"]
        if not pages:
            raise RuntimeError("no page target yet")
        web = [t for t in pages if (t.get("url") or "").startswith(("http://", "https://"))]
        t = (web or pages)[0]
        self.session = self.call("Target.attachToTarget", {"targetId": t["targetId"], "flatten": True})["sessionId"]
        return self.session

    def on_page(self, method, params=None):
        sid = self.page_session()
        try:
            return self.call(method, params, session=sid)
        except RuntimeError:
            # A replaced target or a closed session: attach afresh next time
            # rather than failing every call after it.
            self.session = None
            raise

    def evaluate(self, expr):
        return self.on_page("Runtime.evaluate", {"expression": expr, "returnByValue": True}).get("result", {}).get("value")


def spawn(cmd):
    """The browser, with the pipe on its fds 3 and 4 and nothing else."""
    to_r, to_w = os.pipe()
    from_r, from_w = os.pipe()

    def onto_3_and_4():
        # os.pipe() fds are close-on-exec, and dup2(3, 3) is a no-op that
        # KEEPS the flag: when a pipe end already sits on fd 3, Chrome
        # starts without it and exits before saying a word (the 188 spike).
        # Two defences, either enough alone: duplicating to fresh fds first
        # makes both dup2s real, and pass_fds clears the flag on 3 and 4.
        # tests/test_kiosk_cdp_broker.py runs with the ends on 3 and 4.
        a, b = os.dup(to_r), os.dup(from_w)
        os.dup2(a, 3)
        os.dup2(b, 4)

    proc = subprocess.Popen(cmd, preexec_fn=onto_3_and_4, close_fds=True, pass_fds=(3, 4))
    os.close(to_r)
    os.close(from_w)
    return proc, Pipe(to_w, from_r)


# ── what the broker publishes ──────────────────────────────────────────


def write_page_file(facts):
    os.makedirs(STATE, exist_ok=True)
    tmp = PAGE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    with os.fdopen(fd, "w") as f:
        json.dump(facts, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, PAGE_FILE)


def publish_once(pipe):
    """Ask the page, then write what it said. A page that cannot be asked
    writes NOTHING, so page.json goes stale and `probe` fails: that is the
    watchdog's signal, and a file that kept saying "fine" would hide it."""
    facts = {
        "heartbeat": pipe.evaluate("window.__nooKioskHeartbeat ?? null"),
        # A string literal in the bundle, so it survives minification.
        "build": pipe.evaluate("window.__nooKioskBuild ?? null"),
        "frame": pipe.evaluate("window.__nooKioskFrame ?? null"),
        "updated_at": int(time.time()),
    }
    write_page_file(facts)


def publish_loop(pipe):
    while not pipe.closed:
        try:
            publish_once(pipe)
        except Exception as e:  # noqa: BLE001
            print(f"noo-kiosk-cdp: broker: cannot read the page: {e}", file=sys.stderr, flush=True)
        time.sleep(PUBLISH_EVERY)


# ── the control socket ─────────────────────────────────────────────────


def allowed_uids():
    """root, the display user, and whoever owns the directory this file is
    in. Off a seat that is root (/usr/local/bin); on an enrolled seat it is
    the seat user, whose sync reloads the page after a console roll and who
    can already rewrite this script."""
    here = os.path.dirname(os.path.realpath(__file__))
    return {0, os.getuid(), os.stat(here).st_uid}


def peer_uid(conn):
    return struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))[1]


def answer(conn, pipe, allowed):
    """One request on an accepted connection. The peer is checked before a
    byte is read, and the only verb is `reload`."""
    uid = peer_uid(conn)
    if uid not in allowed:
        conn.sendall(f"refused: uid {uid} may not drive this display\n".encode())
        return
    conn.settimeout(5)
    verb = b""
    while b"\n" not in verb and len(verb) < 64:
        chunk = conn.recv(64)
        if not chunk:
            break
        verb += chunk
    verb = verb.split(b"\n", 1)[0].strip().decode(errors="replace")
    if verb != "reload":
        conn.sendall(f"refused: unknown verb {verb[:32]!r}\n".encode())
        return
    try:
        pipe.on_page("Page.reload", {"ignoreCache": True})
    except Exception as e:  # noqa: BLE001
        conn.sendall(f"error: {e}\n".encode())
        return
    conn.sendall(b"ok\n")


def listen():
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(SOCK)
    # connect() needs WRITE on the socket file, and the seat user is not
    # the display user, so the mode cannot be the gate. The peer check in
    # `answer` is.
    os.chmod(SOCK, 0o666)
    s.listen(4)
    return s


def serve(srv, pipe, allowed):
    while not pipe.closed:
        conn, _ = srv.accept()
        with conn:
            try:
                answer(conn, pipe, allowed)
            except Exception as e:  # noqa: BLE001
                print(f"noo-kiosk-cdp: broker: {e}", file=sys.stderr, flush=True)


def broker(argv):
    if len(argv) < 2 or argv[0] != "--":
        die("usage: noo-kiosk-cdp broker -- BROWSER [ARGS...]", 2)
    proc, pipe = spawn(argv[1:])
    try:
        srv = listen()
    except OSError as e:
        # The page still shows without the socket; only reloads are lost.
        # Say so where status and the journal will see it.
        print(f"noo-kiosk-cdp: broker: no control socket at {SOCK}: {e}", file=sys.stderr, flush=True)
    else:
        threading.Thread(target=serve, args=(srv, pipe, allowed_uids()), daemon=True).start()
    threading.Thread(target=publish_loop, args=(pipe,), daemon=True).start()
    sys.exit(proc.wait())


# ── the reading end: everyone else ─────────────────────────────────────


def page_facts():
    try:
        with open(PAGE_FILE) as f:
            d = json.load(f)
    except FileNotFoundError:
        die("the display has published nothing yet (no page.json): is kiosk.service running?", 5)
    except Exception as e:  # noqa: BLE001
        die(f"page.json unreadable: {e}", 5)
    age = int(time.time()) - int(d.get("updated_at") or 0)
    if age > FRESH_FOR:
        die(f"the browser has not answered for {age}s (page.json is stale)", 5)
    return d


def reload():
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(20)
    try:
        s.connect(SOCK)
        s.sendall(b"reload\n")
        reply = s.recv(512).decode(errors="replace").strip()
    except (FileNotFoundError, ConnectionRefusedError):
        die(f"no broker on {SOCK}: is kiosk.service running?", 5)
    except OSError as e:
        die(f"{SOCK}: {e}", 5)
    finally:
        s.close()
    if reply != "ok":
        die(reply or "the broker closed without answering", 5)
    print("reloaded")


def main(argv):
    if not argv:
        die(__doc__.strip(), 2)
    cmd, rest = argv[0], argv[1:]
    if cmd == "mint":
        mint()
    elif cmd == "broker":
        broker(rest)
    elif cmd == "reload":
        reload()
    elif cmd == "heartbeat":
        v = page_facts().get("heartbeat")
        print("null" if v is None else int(v))
    elif cmd == "build":
        # Which build of the console is on this screen; "null" on a console
        # cut before the stamp existed.
        v = page_facts().get("build")
        print("null" if v is None else str(v))
    elif cmd == "frame":
        # The graph page's smoothed frame work (ms) and drawing tier, or
        # "null" on a view that does not measure one.
        v = page_facts().get("frame")
        print("null" if v is None else json.dumps(v))
    elif cmd == "probe":
        page_facts()
        print("ok")
    else:
        die(f"unknown subcommand {cmd!r}", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
