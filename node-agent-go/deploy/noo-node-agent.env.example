# PAI Node Agent configuration
# Copy to /etc/noo-node-agent.env and edit for your node

# Node identity
NODE_ID=auto
NODE_IP=
NODE_TIER=4

# Controller connection
CONTROLLER_URL=https://192.168.1.100:8080
NATS_URL=tls://192.168.1.100:4222

# Hardware (auto-detected if empty)
GPU_MODEL=
VRAM_GB=0.0

# Auth (from controller's .env or `noo security show-secrets`)
NOO_CLUSTER_SECRET=
NOO_NODE_AGENT_TOKEN=

# TLS certificates (copied from controller)
NOO_TLS_CA=/etc/noo/pki/ca.crt
NOO_TLS_CERT=/etc/noo/pki/node.crt
NOO_TLS_KEY=/etc/noo/pki/node.key
# All three are REQUIRED: :8081 is mTLS-only and the agent refuses to start
# without them (`noo cluster provision <node>` delivers them). NOO_MTLS_NODES
# is retired — leave it out; a stale `false` value refuses the start.
#
# Backend doors. Every backend the agent starts serves TLS with a required
# client certificate: vLLM natively (--ssl-cert-reqs 2), llama.cpp / ollama
# / TEI / the reranker behind a noo-stunnel-<x> sidecar (verify = 2). Each
# needs its leaf at $NOO_PKI_DIR/services/<x>/service.{crt,key} naming the
# door (noo-vllm, noo-stunnel-<x>); without it that backend is refused. The
# NOO_VLLM_TLS / NOO_LLAMACPP_TLS / NOO_OLLAMA_TLS / NOO_TEI_TLS /
# NOO_RERANKER_TLS switches are retired — leave them out; a false/0/no/off
# value refuses the start. STUNNEL_IMAGE overrides the sidecar image.

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=info
