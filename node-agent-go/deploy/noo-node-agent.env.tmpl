# /etc/noo-node-agent.env — environment for the HOST-PROCESS node agent.
#
# Rendered by `noo cluster provision` (noo-cli/src/commands/provision.rs —
# a fail-loud Jinja-subset renderer: variable substitutions with optional
# defaults, plus the one if-block below; every var MUST be supplied, defaults
# are never evaluated). Read by the systemd unit via EnvironmentFile=-/etc/noo-node-agent.env.
# The ansible lane that used to render this retired 2026-09-02.
#
# This is the host-process counterpart of the `environment:` block for the
# node-agent service in docker-compose.cluster.yml. The two must agree on
# VALUES, but NOT on paths: everything the container reached through a bind
# mount is written here as a host-absolute path. See the "container-relative"
# note in the installing task, and CLAUDE.md's rule that a value whose meaning
# is container-relative cannot be shared between services.
#
# The previous container's full environment is saved at
# /etc/noo-node-agent.env.container-backup for diffing during a rollback.

# ── Identity ───────────────────────────────────────────────────────────────
NODE_ID={{ na_node_id }}
NODE_IP={{ node_ip | default('') }}
NODE_TIER={{ node_tier | default('') }}
GPU_MODEL={{ gpu_model | default('') }}

# ── Controller connection ──────────────────────────────────────────────────
CONTROLLER_URL={{ controller_url | default('https://noo-controller:8080') }}
NATS_URL={{ nats_url | default('tls://noo-controller:4222') }}

# ── Auth ───────────────────────────────────────────────────────────────────
# Sourced from the secret store, never from .env — see CLAUDE.md. This file is
# mode 0600 root:root because these two lines are credentials.
NOO_NODE_AGENT_TOKEN={{ noo_node_agent_token | default('') }}
NOO_CLUSTER_SECRET={{ noo_cluster_secret | default('') }}
{# The bus credential is NOT rendered here. A node presents only its own
   NATS_NODE_USER/NATS_NODE_PASSWORD, which the `nats-creds` bundle kind
   merges into this file. The shared NATS_USER/NATS_PASSWORD pair this
   template used to emit was retired; a re-render drops the
   stale lines, and an agent that still has them ignores them. #}

# ── TLS / mTLS — HOST paths, not /app/pki ──────────────────────────────────
# The container got these via ${PAI_PKI_DIR}:/app/pki:ro and then referred to
# /app/pki/... . A host process has no such mount. The installing task
# provision step verifies each of these exists and refuses if one is missing,
# because an agent that starts without them registers as UNREACHABLE — which
# looks like a network fault and sends you debugging the wrong layer.
{% if noo_pki_dir is defined and noo_pki_dir | length > 0 %}
NOO_PKI_DIR={{ noo_pki_dir }}
NOO_TLS_CA={{ na_tls_ca }}
NOO_TLS_CERT={{ na_tls_cert }}
NOO_TLS_KEY={{ na_tls_key }}
# RETIRED. The control API on :8081 is mTLS-only: a cluster-CA client
# certificate is required at the handshake, and without the three files
# above the agent does not start (there is no plaintext listener). This line
# is rendered empty and inert; a leftover false/0/no/off value makes the
# agent REFUSE to start, naming the line, so a downgrade once chosen is loud.
NOO_MTLS_NODES={{ noo_mtls_nodes | default('') }}
{% endif %}

# RETIRED as switches. Every backend this agent starts serves TLS with a
# REQUIRED cluster-CA client certificate at the door a caller reaches:
# vLLM by its own listener (--ssl-cert-reqs 2, the services/vllm leaf),
# llama.cpp / ollama / TEI / the reranker behind a noo-stunnel-<x> sidecar
# the agent runs beside them (verify = 2, the services/<x> leaf). The
# backend's raw port is never published on the host. The per-backend
# NOO_*_TLS switches are retired and no longer rendered; a leftover
# false/0/no/off line from an old env makes the agent REFUSE to start,
# naming the line, so a downgrade once chosen is loud.
# The leaves live under $NOO_PKI_DIR/services/<x>/ — a node without one
# refuses to start that backend (a `cluster verify` row names the fix).
# Where THIS agent reaches ollama for inference jobs. Empty = the compose
# alias (stunnel-ollama) a containerised worker agent resolves; a host agent
# on a standalone controller gets the embed container's loopback publish.
OLLAMA_URL={{ ollama_url | default('') }}
NOO_SELF_NODE={{ noo_self_node | default('') }}

# The CA-signed compatibility lane is retired: a current
# applier refuses a CA-signed bundle that is not a signing-key rollover and
# ignores this key. It is still rendered CLOSED for one reason — an applier
# from before the retirement reads it (default open), so if one were ever
# reinstalled the lane would stay shut. The applier refuses such a downgrade
# too (NOO_APPLY_GENERATION); this is the second lock. Fixed, not a setting.
NOO_APPLY_ACCEPT_CA_SIGNED=0

# ── Storage ────────────────────────────────────────────────────────────────
# Already host paths in the container's env (they were bind-mounted 1:1), so
# these carry over unchanged — but they are listed explicitly rather than
# inherited, so a reader can see the full surface in one file.
# These four are also this node's DECLARED HOST ROOTS: a controller-chosen
# path (node_config.models_dir) must resolve under one of them or the agent
# refuses the placement and reports the refusal on its heartbeat. See
# docs/security/node-agent.md. NOO_HOST_ROOTS (a PATH-style list) is the
# operator's explicit widening.
NOO_DATA_ROOT={{ noo_data_root | default('/var/lib/noo') }}
HF_CACHE_DIR={{ hf_cache_dir | default((noo_data_root | default('/var/lib/noo')) ~ '/hf-cache') }}
MODELS_DIR={{ models_dir | default((noo_data_root | default('/var/lib/noo')) ~ '/models') }}
OLLAMA_DATA_DIR={{ ollama_data_dir | default((noo_data_root | default('/var/lib/noo')) ~ '/ollama') }}
# Default to the name every node can resolve: workers get noo-controller in
# /etc/hosts from prep-host, the controller maps it too (#703).
# An empty value here silently disables BOTH model preseeds and the prop-22
# step-2 image pull rail — found live on host8 2026-08-16 when the first
# rail pull failed "no data plane to pull from" (the container-era env had
# the URL; the cutover lift dropped it — fifth hit of the env-capture class).
NOO_MODEL_CACHE_URL={{ noo_model_cache_url | default('https://noo-controller:8443') }}

# A WSL2 host keeps nvidia-smi in /usr/lib/wsl/lib, which the systemd
# default PATH does not include — so the host agent's GPU probe exec-fails
# and the node claims gpu_count 0 (the CONTAINER agent saw the GPU via the
# nvidia runtime, so this only breaks on cutover; sixth capture gap, found
# live on HOST3 2026-08-16 as "No GPU" on the dashboard). A node claiming
# no GPU is also never probed by the gpu_health autonomy location, so the
# gap silently disarms that watchdog too. The extra entry is harmless on
# non-WSL hosts (nonexistent PATH dirs are skipped).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib

# ── GPU ────────────────────────────────────────────────────────────────────
# NVIDIA_VISIBLE_DEVICES is deliberately ABSENT. It scoped the agent
# CONTAINER's own GPU visibility; a host process inherits the host's devices,
# and the value the compose file passes (`void` by default) would be
# meaningless here. The agent still sets it on the BACKEND containers it
# creates — that path is in the agent's code, not in this file.
NOO_FORCE_GPU={{ noo_force_gpu | default('') }}
NOO_OLLAMA_GPU_COUNT={{ noo_ollama_gpu_count | default('') }}

# Which release this fleet is running. The agent uses these to resolve the
# backend images it starts — without them an x86 node with no local
# hardened build falls back to upstream `ghcr.io/ggml-org/llama.cpp:server`
# (a LOCAL build name, `pai-assistant/llamacpp:latest`, exists only on a
# machine that built it, so llamacpp could never start on a --dist install
# with neither a pin nor a local build — host8, 2026-09-04). Empty on a
# source-built controller, which is correct: there the local images are
# the real ones.
NOO_IMAGE_PREFIX={{ noo_image_prefix | default('') }}
NOO_IMAGE_TAG={{ noo_image_tag | default('') }}

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_AGENT_PORT={{ node_agent_port | default('8081') }}
LOG_LEVEL={{ log_level | default('info') }}
DOCKER_HOST=unix:///var/run/docker.sock

# ── Log shipping ───────────────────────────────────────────────────────────
# The agent ships this node's container stdout/stderr and the journal of
# the units it manages (via noo-hostd's read-only `journal-follow` op) to
# the controller — POST /api/cluster/nodes/<node>/logs with the node leaf
# and the cluster token, gzip, into Loki. ON by default whenever the TLS
# block above is present; it starts only once the controller answers the
# route, so an agent upgraded before its gateway idles harmlessly. State
# (queued / shipped / last accepted / last error) rides the heartbeat as
# `log_ship`. Both lines below are operator overrides, not rendered vars:
# uncomment and edit by hand on the node.
#   NOO_LOG_SHIP=0                      switch shipping off on this node
#   NOO_LOG_SHIP_UNITS=noo-hostd,docker  journal units to request (hostd
#                                        still refuses anything outside its
#                                        own allowlist: noo-node-agent,
#                                        noo-hostd, noo-fetch, noo-harness,
#                                        docker)
#   NOO_AGENT_STATE=/var/lib/noo-node-agent
#                                        where the disk spill (≤128 MB) and
#                                        tail offsets live

# ── Shared GPU ─────────────────────────────────────────────────────────────
# When work outside noomesh takes the GPU, the agent pauses its own GPU
# backends and resumes them once the GPU frees (internal/gpuyield; reported as
# `gpu_contention`). Operator overrides, not rendered vars:
#   NOO_GPU_YIELD=off                   never yield automatically
#   NOO_GPU_YIELD_FOREIGN_MB=2048       foreign GPU use that counts as pressure
#   NOO_GPU_YIELD_AFTER_S=60            pressure this long before yielding
#   NOO_GPU_RESUME_AFTER_S=120          GPU clear this long before resuming
