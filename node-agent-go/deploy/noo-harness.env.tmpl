{# /etc/noo-harness.env — rendered by the controller for one node and
   delivered as the `harness-env` bundle kind. Root-owned,
   0600, read by systemd. The same variables the agent gets for the same
   purposes, under the names the gateway BINARY reads (bus.rs, tls.rs,
   harness_main.rs) — no indirection, no second name (#240).
   No `| default(...)` anywhere: the CLI's renderer is fail-loud and never
   evaluates a default, so every var here is supplied by provision.rs
   (tests/test_provision_template_vars.py pins that). #}
NODE_ID={{ na_node_id }}
NOO_GATEWAY_URL={{ controller_url }}
NATS_URL={{ nats_url }}
{# The node's OWN NATS pair is merged in by the applier from `nats-creds`,
   exactly as for agent.env — a bundle carrying both ends with the pair
   present. These placeholders keep the file self-describing when the
   credential has not arrived yet; the harness then fails to connect and
   says so, rather than connecting as something else. #}
NATS_NODE_USER=
NATS_NODE_PASSWORD=
{% if noo_pki_dir is defined and noo_pki_dir | length > 0 %}
NOO_TLS_CA={{ na_tls_ca }}
NOO_TLS_CERT={{ na_tls_cert }}
NOO_TLS_KEY={{ na_tls_key }}
{% endif %}
{# The model endpoint: this node's agent, over loopback, with this node's
   certificate. Until D lands the agent's proxy is
   controller-only and the harness will report the refusal; that is the
   honest state, not a fallback. #}
NOO_HARNESS_MODEL_URL={{ noo_harness_model_url }}
{# That endpoint is the node agent's AUTHENTICATED inference proxy, and the
   agent refuses a bare request with 401 "Missing node agent auth token" —
   which is exactly what the first turn ever dispatched to a node hit
   (host3, 2026-09-22). The gateway binary already attaches this bearer to
   any :8081 URL when the variable is set (coordinator::with_backend_hint_url);
   this file just never carried it, because it predates phase D. The node's
   own per-node token, not the fleet-wide cluster secret: the agent checks
   the node token first, and a leaked env file then compromises one node,
   not every node. Same file, same 0600 root-only handling as the NATS
   password above. #}
NOO_NODE_AGENT_TOKEN={{ noo_node_agent_token }}
{# Belt and braces: the bearer prefers the token above and falls back to
   the fleet credential when a fleet has no per-node token. The agent's own
   env on this node carries both, in the same root-only 0600 handling.
   Record, so the reason is not misremembered: the 401 that prompted this
   line was NOT an empty token — the renderer refuses
   to run without one. The `--nodes` restage had run under a noo-cli tag
   built before the token line existed, so its embedded copy of THIS file
   had no such line. Env templates ship in the CLI tag, not the stack tag. #}
NOO_CLUSTER_SECRET={{ noo_cluster_secret }}
{# `auto`: the agent's proxy substitutes the model its chat backend serves
   (phase D), so a placement change never needs this file re-rendered.
   `openai`: the proxy speaks the OpenAI-compatible surface whatever engine
   is behind it. #}
NOO_HARNESS_MODEL=auto
NOO_HARNESS_BACKEND=openai
{# NOO_HARNESS_KIND is NOT here. The PLACEMENT owns it — `noo cluster place
   <node> harness <model> --kind noo|claude-code|copilot` writes it to
   `env.NOO_HARNESS_KIND` in the database, the gateway validates it there,
   and the node agent reads it from the placement to enforce the wire
   compatibility table. This file used to assert `noo` as well: a second
   home for a value the database owns, consumed by nothing (the harness
   binary never reads the key), and authoritative-looking to whoever wires
   the foreign runners. One value, one home. #}
NOO_HARNESS_MAX_TURNS={{ noo_harness_max_turns }}
RUST_LOG={{ harness_log }}
