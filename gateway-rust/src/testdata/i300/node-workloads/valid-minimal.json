{
  "format": "noo-addon-node-workloads/1",
  "workloads": [
    {
      "name": "echo",
      "image": "addon-worker",
      "uid": 1000,
      "port": 8080,
      "protocols": [
        "http"
      ],
      "health": {
        "ready": "/ready",
        "live": "/live",
        "start_secs": 10
      },
      "drain": {
        "path": "/drain",
        "done_path": "/drain/done",
        "timeout_secs": 30
      },
      "service_drain": {
        "route": "drain",
        "timeout_secs": 30
      },
      "accel": {
        "gpu": 0
      },
      "limits": {
        "ram_mb": 256,
        "cpus": 0.5,
        "pids": 64
      }
    }
  ]
}
