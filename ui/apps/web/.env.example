# Copy to .env.local (gitignored) and set your gateway origin.
# The dev server proxies /api, /auth, /health, /metrics, /v1 and /ws here.
# Leave unset to use the bundled mock on http://localhost:9800.
#
# Examples:
#   PAI_API_TARGET=http://localhost:8080                 # local gateway
#   PAI_API_TARGET=https://your-gateway.example.ts.net   # remote (Tailscale, etc.)
PAI_API_TARGET=
