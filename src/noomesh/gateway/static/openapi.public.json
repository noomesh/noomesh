    "/.well-known/oauth-authorization-server": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "OAuth 2.0 authorization-server metadata (RFC 8414)",
        "operationId": "identity_metadata",
        "description": "Public discovery for the agent identity exchange. **404 when the `identity` add-on has been switched off** \u2014 discovery answers \"does this exist\", so an install without the add-on advertises nothing. `issuer` is derived from the request `Host` (and `X-Forwarded-Proto`), because a self-hosted controller does not know its own external name. `token_endpoint_auth_methods_supported` is `noomesh_service_key`, a deliberately non-registered value: the credential is a noomesh service key in the `Authorization` header, which is neither `client_secret_basic` nor `client_secret_post`. `response_types_supported` is empty because there is no authorization endpoint \u2014 there is no human to redirect and nothing to consent to.",
        "responses": {
          "200": {
            "description": "Metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "issuer": {
                      "type": "string"
                    },
                    "token_endpoint": {
                      "type": "string"
                    },
                    "grant_types_supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "response_types_supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "token_endpoint_auth_methods_supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "subject_token_types_supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "scopes_supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "service_documentation": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "The `identity` add-on has been switched off on this install."
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "JSON Web Key Set for exchanged agent tokens",
        "operationId": "identity_jwks",
        "description": "Proposal 49 phase 3. The public half of the exchange's ES256 signing key, so a third party can verify an agent token without holding anything that could mint one. Public by definition. **404 when the `identity` add-on is off.** With the add-on on but no `NOO_JWT_SIGNING_KEY` configured, returns `{\"keys\": []}` \u2014 a valid JWKS meaning \"this issuer publishes none\", distinguishable from a misrouted request. Only EXCHANGED tokens are signed asymmetrically; dashboard and CLI logins stay HS256, so there is no dual-accept window on the login path. The gateway selects its verification key from the token's own `alg` and pins validation to that one algorithm, which closes algorithm confusion (an HS256 token signed with the published key as the HMAC secret does not verify).",
        "responses": {
          "200": {
            "description": "The key set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "keys"
                  ],
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kty": {
                            "type": "string",
                            "example": "EC"
                          },
                          "crv": {
                            "type": "string",
                            "example": "P-256"
                          },
                          "x": {
                            "type": "string"
                          },
                          "y": {
                            "type": "string"
                          },
                          "use": {
                            "type": "string",
                            "example": "sig"
                          },
                          "alg": {
                            "type": "string",
                            "example": "ES256"
                          },
                          "kid": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "The `identity` add-on has been switched off on this install."
          }
        }
      }
    },
    "/api/kiosk/token/tailnet": {
      "post": {
        "tags": [
          "other"
        ],
        "summary": "Create tailnet",
        "description": "[native] POST /api/kiosk/token/tailnet \u2014 a kiosk token for a display that holds NO durable secret. The tailnet is the credential. The only kiosk mint: the key lane (POST /api/kiosk/token) was retired on 2026-09-30.",
        "operationId": "token_tailnet",
        "requestBody": {
