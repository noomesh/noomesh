    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Rotate refresh token, mint access token",
        "description": "[native] Reads the HttpOnly refresh cookie (noo_refresh; HttpOnly; Secure; SameSite=Strict; Path=/api/auth), validates and rotates it (single-use; revoked-token replay triggers a defensive revoke of all the user's chains), sets a fresh rotated refresh cookie, and returns a new short-lived access token. Also registered at /auth/refresh.",
        "operationId": "auth_refresh",
        "responses": {
          "200": {
            "description": "New access token issued; a rotated refresh cookie is set via Set-Cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "description": "Freshly minted JWT access token."
                    },
                    "token_type": {
                      "type": "string",
                      "example": "bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "Access token lifetime in seconds."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or replayed refresh cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke refresh token and clear cookie",
        "description": "[native] Revokes the presented refresh token (if any) and clears the HttpOnly refresh cookie (noo_refresh; HttpOnly; Secure; SameSite=Strict; Path=/api/auth) via an expiring Set-Cookie. Idempotent. Also registered at /auth/logout.",
        "operationId": "auth_logout",
        "responses": {
          "200": {
            "description": "Refresh token revoked and cookie cleared.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
