            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OperationHandle": {
        "type": "object",
        "description": "What an operation-backed route answers 202 with when the run outlasted its wait, and what POST /api/v1/ops answers. Poll `poll` (GET, optionally `?wait=<s>`, at most 25).",
        "required": [
          "op_id",
          "type",
          "status",
          "poll",
          "poll_interval_ms"
        ],
        "properties": {
          "op_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "example": "graph.recluster"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running"
            ]
          },
          "poll": {
            "type": "string",
            "example": "/api/v1/ops/0f9c1d2e-0000-4000-8000-000000000001"
          },
          "poll_interval_ms": {
            "type": "integer"
          },
          "hint": {
            "type": "string"
          },
          "joined": {
            "type": "boolean",
            "description": "Present and true when this request joined the same account's run already in flight (exclusive types) and started nothing new."
          }
        }
      },
      "Operation": {
        "type": "object",
        "description": "One asynchronous operation as GET /api/v1/ops/{id} shows it. `result` and `result_status` appear once it has finished; a listing omits them.",
        "required": [
          "op_id",
          "type",
          "status"
        ],
        "properties": {
          "op_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "expired"
            ]
          },
          "poll": {
            "type": "string"
          },
          "poll_interval_ms": {
            "type": "integer"
          },
          "progress": {
            "type": "object",
            "additionalProperties": true
          },
          "params": {
            "type": "object",
            "additionalProperties": true,
            "description": "As stored: ingest text is omitted, over-large params replaced by a marker."
          },
          "result": {
            "description": "The route's own body, in its own shape.",
            "nullable": true
          },
          "result_status": {
            "type": "integer",
            "nullable": true,
            "description": "The HTTP status the synchronous route would have answered."
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "cancel": {
            "type": "object",
            "description": "Present on a cancelled op: {gateway_aborted, worker_stopped, note}. `worker_stopped` is false: a worker run already underway is not stopped.",
            "additionalProperties": true
          },
          "retry_safe": {
            "type": "boolean",
            "description": "On a failed op: whether resubmitting is harmless."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
