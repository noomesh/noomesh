    "/bootstrap/ca.crt": {
      "get": {
        "tags": [
          "other"
        ],
        "summary": "Get ca.crt",
        "description": "[native] GET /bootstrap/ca.crt \u2014 the cluster CA CERTIFICATE (public half only). This is the trust anchor a brand-new node needs BEFORE the first signed bundle can verify: noo-apply refuses everything without it, so birth is the one moment it must arrive out-of-band. Serving it publicly discloses nothing (a certificate is public by construction); the node fetches it during token-authenticated enrollment, which is the sanctioned trust-on-first-use ceremony. The PRIVATE key never leaves noo-cli.",
        "operationId": "serve_cluster_ca",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
