# compiled go node-agent binaries (rebuild with: go build)
node-agent-go/bin/
# host-watcher command spool (runtime command/result/alert files) — keep dir
.pai-host-spool/*
!.pai-host-spool/.gitkeep
# The spool the CURRENT stack writes (§3f R30): docker-compose.cluster.yml
# bind-mounts ./.noo-host-spool into the gateway and the worker, and
# noo-hostd writes hostd.log there. Only the pai-era name was ignored, so
# every runtime command file, result file and log line landed in `git
# status` as untracked — and an untracked spool is one `git add -A` away
# from committing whatever a command payload happened to contain.
.noo-host-spool/*
!.noo-host-spool/.gitkeep

# Local per-developer git-hooks directory (not shared across team)
config/tailscale-acl.backup.*

# Machine-specific cluster truth — never committed
config/cluster-seed.yaml
ansible/inventory/hosts

# Runtime artifacts
data/models.db

# Rebuild markers written by pai-metis-rebuild.sh on every build — pure (leak-ok: names the retired pai-metis script, not a secret)
# local state (sync-to-oss.sh already excludes them). Tracking them kept
# the main clone perpetually dirty, which is what turns `git pull` into a
# silent no-op mid-deploy.
.build-hash

# built locally by the Makefile; the image is built from docker/Dockerfile.node-agent-go
node-agent-go/node-agent
node-agent-go/bin/

# Add-on terms acceptance log (noo security entitlement install): written to the
# state home, which is the checkout root in a dev tree. Holds host and user names.
addon-terms-acceptances.jsonl

# onboarding film output (scripts/demo)
demo-out/
