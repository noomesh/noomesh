        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "tier": true,
              "tier 1": true,
              "tier 2": true,
              "tier 3": true
            },
            "indexByName": { "node_id": 0, "Value #D": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4 },
            "renameByName": { "node_id": "Node ID", "Value #A": "Load %", "Value #B": "VRAM (GB)", "Value #C": "Backends", "Value #D": "Tier" }
          }
        }
      ],
      "type": "table"
    },
