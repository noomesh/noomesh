# noo-whisper — faster-whisper behind the OpenAI-compatible audio API.
#
# The opt-in compose `whisper` service (profile "voice"): the first concrete
# provider behind the gateway's generic STT layer (gateway-rust/src/stt_client.rs
# speaks to it with the default "openai" wire format).
#
# Why build our own instead of pulling speaches/faster-whisper-server:
#   - those images are pullable but ship a full model-management stack and
#     only accept HuggingFace repo ids as model names; `pai voice transcribe`
#     sends faster-whisper size names ("base") by default.
#   - this shim is ~150 lines of auditable Python over the same
#     faster-whisper engine the retired in-process voice module used, with
#     identical decode parameters (see docker/whisper_server.py).
#   - anyone who prefers speaches/LocalAI/vLLM-audio/OpenAI cloud points
#     NOO_STT_URL at it — same wire format, no gateway change.
#
# CPU by default (int8). CUDA needs a CUDA-libs base image — the long-term
# GPU home is a node-agent backend spec (node-agent-go internal/docker/
# backends.go, like embedding/reranker), not this compose service.
#
# Tag+digest pinned like the nats upstream in docker-compose.cluster.yml.
# Docker Hub base via the GHCR mirror (.github/hub-mirror.txt): Hub rate-limits
# pulls per IP. Needs a ghcr.io login; without one, build with
# --build-arg HUB_MIRROR=docker.io.
ARG HUB_MIRROR=ghcr.io/noomesh/mirror
FROM ${HUB_MIRROR}/library/python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

# faster-whisper bundles decode via PyAV (static ffmpeg libs in the wheel)
# and VAD via onnxruntime — no system packages needed.
# `requests` is imported by faster_whisper.utils but missing from its
# declared deps at this pin — install it explicitly.
#
# EVERY package is pinned, transitive ones included, and installed with
# --no-deps so nothing resolves at build time. A floating dep is how STT
# broke silently in stack 0.6.5: faster-whisper 1.1.1 declares `av>=11`,
# the build resolved av 19.0.1, which dropped `metadata_errors` from
# av.open() — and faster_whisper/audio.py decode_audio passes it, so every
# transcription was a 422 (`open() got an unexpected keyword argument
# 'metadata_errors'`). av 18.1.0 is the newest that still accepts it
# (faster-whisper 1.2.1 passes it too, so a bump does not help).
# tests/test_voice_images_pinned.py refuses an unpinned line here;
# tests/test_whisper_server_decode.py runs the real decode_audio.
# To move a pin: resolve in a throwaway python:3.12-slim, `pip freeze`,
# replace the list below, and run both tests against that av.
RUN pip install --no-cache-dir --no-deps \
        faster-whisper==1.1.1 \
        av==18.1.0 \
        ctranslate2==4.8.3 \
        onnxruntime==1.31.0 \
        tokenizers==0.23.3 \
        huggingface_hub==2.2.0 \
        hf-xet==1.7.0 \
        httpx2==2.13.1 \
        httpcore2==2.13.1 \
        truststore==0.10.5 \
        numpy==2.5.4 \
        flatbuffers==25.12.19 \
        protobuf==7.36.2 \
        filelock==4.2.0 \
        fsspec==2026.9.0 \
        packaging==26.3 \
        PyYAML==6.0.3 \
        tqdm==4.70.1 \
        requests==2.34.2 \
        certifi==2026.7.22 \
        charset-normalizer==3.5.2 \
        idna==3.20 \
        urllib3==2.8.0 \
        fastapi==0.115.14 \
        starlette==0.46.2 \
        pydantic==2.14.1 \
        pydantic_core==2.50.1 \
        annotated-types==0.8.0 \
        typing-inspection==0.4.4 \
        typing_extensions==4.16.0 \
        anyio==4.15.1 \
        uvicorn==0.34.3 \
        click==8.5.0 \
        h11==0.16.0 \
        python-multipart==0.0.32 \
    && pip check

# Vendor telemetry off (docs/security/telemetry.md), baked into the image so
# a container started outside compose carries it too; compose sets the same.
ENV HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1

WORKDIR /app
COPY docker/voice_local.py /app/voice_local.py
COPY docker/whisper_server.py /app/whisper_server.py

# Non-root (i105): uid/gid 65532 named `nonroot`, the DHI convention the
# rest of the stack runs as. Nothing here writes a model: the controller
# stages them (`noo models pull whisper:<size>`, the CLI's voice_models.rs)
# and compose mounts `<MODELS_DIR>/voice/whisper` READ-ONLY at /models; the
# server loads `/models/<name>` with local_files_only (docker/voice_local.py)
# and runs offline (HF_HUB_OFFLINE=1). The only run-time write is one
# tempfile per request in /tmp (already 1777). /models is just the mount
# point, root-owned and read-only to nonroot. The service key is handed to
# this uid (noo-cli pki.rs SERVICE_KEY_READERS).
RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --create-home --home-dir /home/nonroot \
        --shell /usr/sbin/nologin nonroot \
    && mkdir -p /models

ENV WHISPER_MODEL_DIR=/models \
    WHISPER_MODEL=base \
    WHISPER_DEVICE=auto \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

EXPOSE 8000

# curl-less healthcheck (slim image): python stdlib probe.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).status==200 else 1)"

USER nonroot

CMD ["uvicorn", "whisper_server:app", "--host", "0.0.0.0", "--port", "8000"]
