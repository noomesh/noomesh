# Mesh Gateway — Rust implementation
#
# Three stages: build the binary with the Rust toolchain, build the small
# Python dependency set, run on a plain slim base. NOTHING here is FROM
# deps-base any more — that base carries the memory subsystem and its ML tree
#, which this container has no use for.

# Global build args (declared before the first FROM so FROM lines can use
# them — stage-local ARGs cannot appear in FROM).
#
# The dashboard is the versioned mesh-ui-web artifact, always. There is
# no second UI to select between any more (see the UI block further down).
# Base-image registry: dhi.io by default (local/dev/OSS builds), our ghcr
# MIRRORS in the release workflow (--build-arg DHI_REGISTRY=ghcr.io/…) —
# dhi.io TLS timeouts have now broken four builds (build-from-mirrors,
# 2026-08-20). Digest-pinned FROMs survive the swap: manifest copies
# preserve digests.
ARG DHI_REGISTRY=dhi.io
# LOCAL-BUILD FALLBACK ONLY. A release always passes --build-arg UI_IMAGE with
# the stack tag it is building (images-release.yml), so a gateway tagged
# stack-vX embeds the console tagged stack-vX and the two cannot disagree.
# `latest` here means "whatever a developer last published", which is right for
# a local build and would be wrong — silently — for a release.
ARG UI_IMAGE=ghcr.io/noomesh/mesh-ui-web:latest
# NOT the `-sfw` variant. That image bundles Socket Firewall, which proxies
# outbound package fetches — and when its upstream service is unreachable it
# fails the whole build with "Socket Firewall encountered an unexpected error:
# TypeError: fetch failed" the moment cargo needs to download a crate. That
# stayed invisible for several releases because the persistent buildx cache on
# the self-hosted runner already held every crate; the first Cargo.lock change
# (the quinn-proto CVE bump) invalidated it and broke the gateway build.
#
# This is the BUILDER stage only — it is discarded, and the runtime image is
# a plain slim base — so hardening here buys us little while costing the
# ability to build at all when the firewall service is down.
# ── Dashboard UI ──────────────────────────────────────────────────────────
# The versioned mesh-ui-web artifact (FROM scratch, nothing but /dist),
# pinned by UI_IMAGE. One UI, every build.
#
# There used to be a second source — a vendored in-tree snapshot of the
# legacy vanilla-JS console, selected by UI_SOURCE, kept so dev builds
# needed no registry access. Two consoles meant every UI change had to be
# made twice or silently ship half-done, and which one you were looking at
# depended on how the stack happened to be started — a distinction nothing
# in the UI surfaced. It is retired to legacy/vendored-console/ (kept for
# reference, excluded from the build context) and no longer selectable.
#
# The cost, stated plainly: building this image now requires pulling the
# mesh-ui-web package from GHCR (UI_IMAGE). A build that cannot reach it
# fails at the pull instead of quietly producing a gateway with a stale UI,
# which is the better failure.
#
# (The ARG is declared at the top of the file — FROM lines only see
# global-scope ARGs. This stage sits BEFORE the builder so it cannot split
# another stage's body.)
FROM ${UI_IMAGE} AS ui

FROM ${DHI_REGISTRY}/rust:1-debian13-dev AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Step 1: Cache dependencies only (rebuilds only when Cargo.toml changes).
# Cargo registry cache is mounted so re-downloads don't happen across builds.
COPY gateway-rust/Cargo.toml gateway-rust/Cargo.lock* ./
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git,sharing=locked \
    mkdir src && \
    echo "fn main() { println!(\"deps-only placeholder\"); }" > src/main.rs && \
    cargo build --release && \
    rm -rf src target/release/deps/noo_gateway* target/release/noo-gateway

# Step 2: Build actual source. Cache mounts on /build/target + cargo registry
# let incremental compilation work across rebuilds — only changed files
# recompile instead of the full crate. Binary is copied OUT of the mount
# because cache mounts vanish at end-of-layer.
#
# `sqlx::query!` verifies SQL against a real schema at COMPILE time. The build
# has no database, so it reads the committed `.sqlx/` cache instead — that is
# what SQLX_OFFLINE=true selects. Without the COPY the build fails closed with
# "`SQLX_OFFLINE=true` but there is no cached data", which is the intended
# behaviour: a missing cache must never silently fall back to an unchecked
# query. Regenerate with `scripts/sqlx-prepare.sh` after changing any SQL.
ENV SQLX_OFFLINE=true
COPY gateway-rust/.sqlx ./.sqlx
COPY gateway-rust/src ./src
# The external MCP door embeds this at compile time
# (`mcp_external.rs: include_str!("../mcp-tools.json")`), so it must be in the
# build context alongside src/ — it is NOT under src/, and without this line
# the build dies with:
#   error: couldn't read `src/../mcp-tools.json`: No such file or directory
# Nothing else catches that: `cargo check`/`cargo test` and the CI rust job
# both build from a full checkout where the file is simply present, so the
# COPY list is the only place this dependency has to be declared.
COPY gateway-rust/mcp-tools.json ./mcp-tools.json
# The LOCAL door's manifest (mcp_local.rs: include_str!("../mcp-tools-local.json"))
# — exactly the failure the comment above warned about, hit live on the
# v0.1.39 build: local checks pass from a full checkout, only this COPY
# list knows what the image build can see.
COPY gateway-rust/mcp-tools-local.json ./mcp-tools-local.json
# The node-tier ladder's behavioural corpus (node_tier.rs:
# include_str!("../fixtures/node_tier_cases.json")). Same class of dependency
# as the two manifests above — it lives outside src/, so only this COPY list
# knows the image build needs it, and a missing line fails at compile with
# "couldn't read src/../fixtures/...". The whole directory, so a second
# ladder fixture does not become a second Dockerfile edit.
COPY gateway-rust/fixtures ./fixtures
# The log-redaction corpus is SHARED with the Go shipper's tests, so it lives
# at the repo root and src/redact.rs include_str!s it as ../../tests/fixtures/…
# (tests/test_rust_build_context_complete.py is what notices when a COPY is
# missing; tests/test_log_redaction_parity.py is what holds the two tables
# equal).
COPY tests/fixtures/redaction_corpus.json /tests/fixtures/redaction_corpus.json
# The audit hash-v2 vectors, shared with the Python writer's tests the same
# way (src/audit_integrity.rs include_str!s them).
COPY tests/fixtures/audit_hash_v2_vectors.json /tests/fixtures/audit_hash_v2_vectors.json
COPY tests/fixtures/audit_chain_vectors.json /tests/fixtures/audit_chain_vectors.json
COPY tests/fixtures/kb_audience_isolation.json /tests/fixtures/kb_audience_isolation.json
# The own-image rule's shared cases (routes/artifacts.rs tests include_str! it;
# the node agent and noo-cli read the same file).
COPY tests/fixtures/own_image_cases.json /tests/fixtures/own_image_cases.json
# The harness kinds table (src/harness_kinds.rs include_str!s it as
# ../../config/harness-kinds.json); the node agent embeds a copy of it.
COPY config/harness-kinds.json /config/harness-kinds.json
# The harness profile defaults per tier (src/harness_profile.rs include_str!s
# it as ../../config/harness-profiles.json).
COPY config/harness-profiles.json /config/harness-profiles.json
# The provisioned Grafana dashboards: src/routes/grafana_ds.rs include_str!s
# each one as ../../../configs/grafana/dashboards/… and builds the read-only
# tier's query allow-list from them. One line per file;
# tests/test_grafana_sso_parity.py holds this list to the directory.
COPY configs/grafana/dashboards/cluster-overview.json /configs/grafana/dashboards/cluster-overview.json
# Same class of dependency as mcp-tools.json above, and the reason that
# comment exists — these were BOTH missing:
#
# build.rs sets the has_pro_routes cfg by probing for
# pro-only files. Cargo AUTO-DETECTS build.rs, so when it is absent there is
# no error at all: the build script simply never runs and every cfg silently
# stays off. That is how the shipped image ended up with NO pro routes
# compiled in (`/api/ga/*`, `/api/hofstadter-loop/*` were absent from the
# binary) while every local `cargo build` had them, because a local build
# runs from a full checkout. Silent, and invisible to every Rust CI job for
# the same reason.
COPY gateway-rust/build.rs ./build.rs
# migrations/ holds the mesh schema baselines that mesh_migrate.rs embeds
# with include_str!. Unlike build.rs this one fails loudly:
#   error: couldn't read `src/../migrations/0001_baseline.sql`
COPY gateway-rust/migrations ./migrations
# The fingerprint removal below is NOT cosmetic — without it this build
# silently ships STALE code.
#
# cargo decides what to recompile by comparing each source file's mtime
# against the fingerprint recorded in target/. BuildKit does not preserve
# the build context's mtimes through COPY, so the copied sources can land
# with a timestamp that is not newer than the artifacts already sitting in
# the persistent cache mount. cargo then concludes nothing changed, skips
# the crate, and `cp` copies the PREVIOUS binary out.
#
# The failure is silent and very hard to attribute: the layer cache
# correctly invalidates, the build runs, BuildKit reports "Built", the
# image timestamp is fresh — and the binary is old. Diagnosed 2026-07-31
# after a merged change (#334) did not run in production; the binary
# contained #281 and #283 but not the newer edit, and only a grep of the
# running binary against a known-present control string revealed it.
#
# The fix deletes this crate's FINGERPRINT rather than touching mtimes:
# it targets cargo's staleness record directly, needs only `rm` (the
# hardened builder image has no `find` — an earlier `find ./src -exec
# touch` attempt failed with exit 127), and cannot be defeated by whatever
# timestamps BuildKit happens to write.
#
# Only noo-gateway's own fingerprint is removed, so the expensive
# dependency build stays cached: deps are compiled in the step above from
# Cargo.toml alone and are untouched here. This costs one crate's compile,
# not the full tree.
# CONCURRENT BUILDS. `id=` is a fixed key, so every build on this host shares
# ONE mutable /build/target. BuildKit's default `sharing=shared` lets them in
# at the same time, and two cargos writing one target dir corrupt each other:
# observed 2026-08-01 with parallel agents building from different worktrees —
# `failed to write .../.fingerprint/noo-gateway-<hash>/bin-noo-gateway` and
# `could not parse/generate dep info at .../noo_gateway-<hash>.d`. Both look
# like a broken toolchain and are not; a plain retry succeeds once the other
# build finishes.
#
# `sharing=locked` makes the second build WAIT instead of interleaving. That
# is the right default here: correctness over parallelism, and it costs no
# extra disk.
#
# For genuinely parallel worktree builds, override the cache key instead:
#   docker build --build-arg CARGO_CACHE_ID=cargo-target-<worktree-slug> ...
# That gives each worktree its own target dir — but each is multiple GB, so
# weigh it against the .vhdx growth problem before making it a habit.
ARG CARGO_CACHE_ID=cargo-target
RUN --mount=type=cache,target=/build/target,id=${CARGO_CACHE_ID},sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git,sharing=locked \
    rm -rf target/release/.fingerprint/noo-gateway-* && \
    cargo build --release && \
    cp target/release/noo-gateway /noo-gateway-built

# ── Runtime ──
#
# NO Python dependency stage any more. This image used to carry a second
# build stage that pip-installed alembic/sqlalchemy/psycopg, for exactly one
# purpose: `python /opt/entrypoint.py` applying the mesh Alembic chain
# before exec'ing the binary. an earlier change moved that chain to a native sqlx
# runner (gateway-rust/src/mesh_migrate.rs) and an earlier change had already
# moved PKI staging, the CA bundle, Claude settings and git identity into
# startup_tasks.rs — so nothing Python-shaped is left to run here.
#
# NON-DEV base, which is the whole point: dhi.io/python:3.12-debian13 has no
# shell, no apt, no package manager. The `-dev` variant this used to be FROM
# carried all three plus git and libpq5. What made the swap possible, in the
# order it had to be true:
#
#   1. entrypoint.py gone          -> no interpreter needed to start
#   2. startup_tasks.rs writes .git/config directly rather than shelling out
#      to `git config`                                  -> no git binary
#   3. cert_expiry::read_not_after replaced the one `openssl x509` subprocess
#      in autonomy_evaluators.rs   -> `Command::new` appears NOWHERE in the
#      binary, so nothing can want a shell
#   4. psycopg gone                -> no libpq5
#
# Debian 13 is NOT interchangeable here. The builder is dhi.io/rust:1-debian13-dev
# (glibc 2.41) and the binary needs GLIBC_2.38/2.39; a bookworm runtime
# (glibc 2.36) builds clean and then dies at exec with
#   /usr/local/bin/noo-gateway: libc.so.6: version `GLIBC_2.38' not found
# Verified in THIS base before cutting over: glibc 2.41, /bin/sh absent,
# /etc/ssl/certs/ca-certificates.crt present, user already 65532.
#
# Because there is no shell there can be no RUN instruction below this line.
# Everything is COPY, and every CMD/ENTRYPOINT/HEALTHCHECK must be exec form
# — shell form would be silently unrunnable.
FROM ${DHI_REGISTRY}/python:3.12-debian13@sha256:4da000f376259ab2e5832ae781db58b04f2f67b9acc9f5b17ecc9568742e70b4

# No user creation needed: dhi.io images ship `nonroot` at 65532:65532 — the
# same uid/gid the container ran as under deps-base, so mounted volume
# ownership is unchanged. (An earlier cut of this used a stock python image
# and had to useradd it by hand; the hardened base makes that unnecessary.)

# ffmpeg is NOT installed here. It was 258 MB of static
# binaries justified as "pydub audio conversion" for in-process voice mode —
# a path that no longer runs in this container. Verified before removing:
# gateway-rust invokes ffmpeg/ffprobe nowhere, stt_client and tts_client
# forward audio bytes to the provider service over HTTP multipart without
# transcoding or spawning anything, and no module under noomesh imports
# pydub (it survived only as an undeclared transitive).
#
# The consumers that genuinely need it keep it: noo-trellion has its own
# COPY for recall-memory work, and the whisper/piper provider images bring
# their own.
# Docker CLI intentionally NOT installed — the gateway has no Docker access;
# container lifecycle is owned by the host-side noo-hostd via the command
# spool (./.noo-host-spool → /var/run/noo-spool).

COPY --from=builder /noo-gateway-built /usr/local/bin/noo-gateway

# Operator/recovery scripts. These are DATA here, not programs: nothing in
# this container can execute them any more (no shell, and `Command::new`
# appears nowhere in the binary). The ones that must be present are the
# pull-rail node tooling paths.rs resolves and the gateway SERVES over HTTP:
# bootstrap-enroll.sh (GET /bootstrap), prep-host.sh (/bootstrap/prep),
# noo-apply.sh, noo-fetch.sh and deenroll-node-local.sh. The rest are run by
# the HOST, outside this container.
#
# --chmod replaces the old `RUN chmod +x`, which is not available without a
# shell. The bit is preserved for the host-side consumers that bind-mount
# these paths.
COPY --chmod=755 scripts/ /app/scripts/

WORKDIR /app

# NO `COPY src` and NO PYTHONPATH.
#
# The Python source tree was here for entrypoint.py to import noomesh.db
# (the Alembic chain). With the chain ported to sqlx nothing in this image
# imports anything. Checked before deleting rather than assumed: paths.rs
# declares PYTHON_SRC and PROMPT_SKILLS_DIR pointing into /app/src, and
# grep finds ZERO consumers of either constant in gateway-rust — they are
# removed in this change so the code stops describing a directory that is
# not there.
#
# What DID need extracting is the static assets (`/app/static`,
# paths::STATIC_DIR): the API contract the dashboard's reference view reads.
# The dashboard itself is the UI artifact under /var/www. The last page
# served from /app/src (`/ui/basic`, an inline-script chat page with no
# login) is retired: it was the one reason the CSP allowed inline scripts.
#
# TWO trees, two jobs:
#
#   /app/static — in-tree files the artifact does not carry and never will:
#     openapi.json (the API contract, served to the dashboard's reference
#     view). Kept as a directory COPY so the
#     compose dev overlay still has something to mount over.
#   /var/www — the UI artifact's /dist, wholesale: index.html + assets/.
#
# NOO_UI_SOURCE is gone with the vendored path. There is nothing left to
# select, so recording a selection would be a variable that can only hold
# one value — and a reader would reasonably assume the other value still
# works.
COPY src/noomesh/gateway/static /app/static
COPY --from=ui /dist /var/www

COPY docker/mcp-servers.json /app/.mcp.json
COPY config/tools.json /app/config/tools.json
# Operational runbooks — served by /api/docs/runbooks (task #14). Without
# this COPY the dist image booted with an EMPTY runbook cache and the
# dashboard Docs tab had nothing to show even once the route existed.
COPY docs/operating/runbooks /app/docs/runbooks

EXPOSE 8080

# EXEC form, and the binary probes itself — see main.rs::health_probe.
#
# The old probe was `CMD python -c "import urllib.request…" || exit 1`. Both
# halves are now impossible: there is no interpreter, and `||` is shell
# syntax that a shell-less image cannot evaluate. There is no curl or wget
# either, so the only executable available to probe with is the gateway.
#
# Docker treats a non-zero exit as unhealthy, so `|| exit 1` was always
# redundant; health_probe exits 1 explicitly on every failure path.
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD ["/usr/local/bin/noo-gateway", "--health"]

USER nonroot

# The binary IS the entrypoint. entrypoint.py is not copied into this image
# any more; it survives in the repo because noo-trellion and the sandbox
# image still use it (trellion owns the memory Alembic env and genuinely
# needs a Python entrypoint).
#
# CMD is kept empty-but-overridable: compose passes no command, and argv[1]
# is now meaningful to the binary (`--health`).
ENTRYPOINT ["/usr/local/bin/noo-gateway"]
