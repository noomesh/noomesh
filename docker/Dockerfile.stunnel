# Minimal stunnel TLS sidecar
# Wraps mTLS around services that don't support native TLS (Ollama, TEI)
#
# openssl (the CLI) is here for the sidecars' healthchecks: a check that
# presents the sidecar's own leaf through its own door proves the listener,
# the client-cert requirement and the upstream at once. busybox wget cannot
# present a certificate.

# Docker Hub base via the GHCR mirror (.github/hub-mirror.txt): Hub rate-limits
# pulls per IP. Needs a ghcr.io login; without one, build with
# --build-arg HUB_MIRROR=docker.io.
ARG HUB_MIRROR=ghcr.io/noomesh/mirror
FROM ${HUB_MIRROR}/library/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

RUN apk add --no-cache stunnel openssl
RUN adduser -D -H stunnel 2>/dev/null || true

# Runs as root ON PURPOSE (the only first-party image that still does, with the
# nvidia exporter): the service leaf key it reads is mode 0600, owned by the
# operator who issued it (noo-cli pki.rs KeyReader::ContainerRoot: root inside
# the container reads it through CAP_DAC_OVERRIDE). A non-root USER here would
# need every stunnel-* service key handed to a fixed uid (the ContainerUid
# path, a chown that needs sudo on each host) - a change to the PKI key table,
# not to this image. The base is current alpine pinned by digest (3.19 was end
# of life), and the stunnel.conf the sidecars mount sets `pid =` and
# `foreground = yes`, so nothing else needs root.

ENTRYPOINT ["stunnel"]
CMD ["/etc/stunnel/stunnel.conf"]
